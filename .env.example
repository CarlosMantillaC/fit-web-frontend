# Copia este archivo a `.env` y ajusta los valores.
# Vite solo expone las variables prefijadas con VITE_.
VITE_API_URL=/api
VITE_APP_NAME=Fit Web

# En producción (Render Static Site) VITE_API_URL se define en el dashboard
# o en render.yaml (sync: false). Ejemplo:
# VITE_API_URL=https://fit-web-backend.onrender.com/api
